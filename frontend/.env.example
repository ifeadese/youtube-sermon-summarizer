# Copy to `.env` (gitignored) to override defaults.
# Google Analytics Measurement ID (e.g. G-1KQEW3967D). Leave empty to disable.
VITE_GA_MEASUREMENT_ID=

# Gemini API key used ONLY by scripts/gemini-spike.mjs (put it in .env.local,
# never here). The app itself never reads this: users supply their own key in
# the browser.
GEMINI_API_KEY=
