# Copy to `.env` (gitignored) to override defaults.
# Base URL of the backend API. Defaults to the local dev server if unset.
VITE_API_BASE_URL=http://localhost:8000
# Google Analytics Measurement ID (e.g. G-1KQEW3967D)
VITE_GA_MEASUREMENT_ID=

# Gemini API key used ONLY by scripts/gemini-spike.mjs (put it in .env.local, never here).
# The app itself never reads this: users supply their own key in the browser.
GEMINI_API_KEY=
